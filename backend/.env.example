APP_NAME=RehabMotion API
APP_ENV=development
API_V1_PREFIX=/api/v1
# Change this before using the backend outside local development.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-before-deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Docker Compose uses the service hostname "db".
DATABASE_URL=postgresql+psycopg://rehabmotion:rehabmotion_dev_password@db:5432/rehabmotion
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
